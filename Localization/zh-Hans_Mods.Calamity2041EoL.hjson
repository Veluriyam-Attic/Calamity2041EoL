Configs: {
	EoLConfig: {
		DisplayName: 光之女皇配置

		FightInBossRush: {
			Label: 在 Boss Rush 中战斗
			Tooltip: 是否让光之女皇加入 Boss Rush。
		}
	}
}

Items: {
	LoreEmpressofLight: {
		DisplayName: 光之女皇（传颂之物）
		Tooltip:
			'''
			寄宿其上的低语流入你的耳中……
			按住Shift键以仔细聆听
			'''
		Lore:
			'''
			尽管这个名称听起来很神圣，但她更像是一位代表着绝对力量与自然之怒的使者。
			在白天，她甚至可以引导原始之光本身，让她几乎无人可及。
			庆幸的是，如果她所能操控的只剩下星光，那她的本事就和其余那些狼狈的暴君没什么差别。
			她的嗜好十分独特，她喜好吸取其他强大生命的力量，这让我感到十分可悲。
			这让她产生了一种病态般的顺从。尽管依赖于此但她仍心甘情愿，毕竟只有这样才能满足她永恒的饥渴。
			我曾因她的变节而决定亲手杀掉她，但她在隐藏踪迹这一方面可谓万里挑一。
			'''
	}
}

ItemTooltip: {
	SoaringFlight: 飞行时间增加 25%
	SoaringMovement: 移动和跳跃速度增加 10%，加速度增加 1.1 倍
}
